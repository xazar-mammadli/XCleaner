      }
    },
    "Frees the space taken by local Time Machine snapshots, which macOS keeps between backups. Backups on your backup disk stay as they are." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-un yedəkləmələr arasında saxladığı lokal Time Machine snapshot-larının tutduğu yeri boşaldır. Yedəkləmə diskindəki yedəklər olduğu kimi qalır."
          }
        }
      }
    },
    "Full Disk Access" : {
