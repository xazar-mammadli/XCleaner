    "This copy of XCleaner wasn't installed from a release, so it can't update itself. Download the new version from the release page." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner-in bu nüsxəsi release-dən quraşdırılmayıb, ona görə özünü yeniləyə bilmir. Yeni versiyanı release səhifəsindən yükləyin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия XCleaner установлена не из релиза, поэтому не может обновиться сама. Скачайте новую версию со страницы релиза."
          }
