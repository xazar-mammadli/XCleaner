    },
    "Preference panes, plug-ins and browser extensions." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parametr panelləri, plaginlər və brauzer genişlənmələri."
          }
        }
      }
    },
    "Privacy" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Məxfilik"
          }
        }
      }
    },
    "Processor, memory, disk, battery and network at a glance." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosessor, yaddaş, disk, batareya və şəbəkə bir baxışda."
          }
        }
      }
    },
    "Purgeable" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşaldıla bilən"
          }
        }
      }
    },
    "Quick Cleanup" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürətli təmizlik"
          }
        }
      }
    },
    "Reindex Spotlight and Mail, flush the DNS cache and thin local snapshots." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight və Mail indeksini yeniləyin, DNS keşini təmizləyin, lokal snapshot-ları azaldın."
          }
        }
      }
    },
    "Remaining Files" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qalıq fayllar"
          }
        }
      }
    },
    "Remove an app together with all of its support files." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramı bütün köməkçi faylları ilə birlikdə silin."
          }
        }
      }
    },
    "Remove junk your Mac doesn't need: caches, logs, leftovers and old installers." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-ın ehtiyacı olmayan zibili silin: keşlər, loglar, qalıqlar və köhnə quraşdırıcılar."
          }
        }
      }
    },
    "Removed items" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinən elementlər"
          }
        }
      }
    },
    "Removed items go to the Trash, so you can put them back." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinənlər Zibil qutusuna gedir, onları geri qaytara bilərsiniz."
          }
        }
      }
    },
    "Reset Apps" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramları sıfırlama"
          }
        }
      }
    },
    "Restart Now" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndi yenidən başlat"
          }
        }
      }
    },
    "Restart XCleaner to use the new language." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni dil XCleaner yenidən başladıqdan sonra tətbiq olunacaq."
          }
        }
      }
    },
    "Return an app to its first-launch state without reinstalling it." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramı yenidən quraşdırmadan ilk açılış vəziyyətinə qaytarın."
          }
        }
      }
    },
    "Safety" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təhlükəsizlik"
          }
        }
      }
    },
    "Scan and review as usual, but nothing is removed." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skan və baxış həmişəki kimi işləyir, amma heç nə silinmir."
          }
        }
      }
    },
    "See what starts with your Mac and what slows it down." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ilə birlikdə nəyin işə düşdüyünü və onu nəyin yavaşlatdığını görün."
          }
        }
      }
    },
    "Set Up Access…" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İcazəni qur…"
          }
        }
      }
    },
