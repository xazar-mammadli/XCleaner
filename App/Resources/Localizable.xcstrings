            "value" : "Sırala"
          }
        }
      }
    },
    "Space macOS frees on its own when it needs it, such as local snapshots and optimized iCloud copies." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-un lazım olanda özü boşaltdığı yer: lokal snapshot-lar, optimallaşdırılmış iCloud nüsxələri və s."
