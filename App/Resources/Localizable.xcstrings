    "Apps" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramlar"
          }
        }
      }
    },
    "Apps and command-line tools keep their settings and data in hidden items, so move one to the Trash only if you know what it is. Keys and passwords are never offered." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramlar və komanda sətri alətləri ayarlarını və məlumatlarını gizli elementlərdə saxlayır, ona görə birini Zibil qutusuna yalnız nə olduğunu bilirsinizsə atın. Açarlar və parollar heç vaxt təklif olunmur."
          }
        }
      }
    },
    "Apps that use the most memory, CPU and GPU, updated every two seconds." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ən çox yaddaş, CPU və GPU işlədən proqramlar. Hər iki saniyədən bir yenilənir."
          }
        }
      }
    },
    "Apps that use the most memory, CPU and GPU." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ən çox yaddaş, CPU və GPU işlədən proqramlar."
          }
        }
      }
    },
    "Apps you removed didn't leave anything behind." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sildiyiniz proqramlar heç nə qoyub getməyib."
          }
        }
      }
    },
