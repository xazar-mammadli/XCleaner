    "History, cookies and caches of Safari, Chrome, Firefox, Edge and Brave." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, Chrome, Firefox, Edge və Brave-in tarixçəsi, cookie-ləri və keşi."
          }
        }
      }
    },
    "History, cookies and caches your browsers keep. Passwords, bookmarks and open tabs are never touched." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauzerlərinizin saxladığı tarixçə, çərəzlər və keşlər. Parollara, əlfəcinlərə və açıq tablara heç vaxt toxunulmur."
          }
        }
      }
    },
    "Holds keys, tokens or passwords, so XCleaner never offers to remove it." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçində açarlar, tokenlər və ya parollar var, ona görə XCleaner onu silməyi heç vaxt təklif etmir."
          }
        }
      }
    },
    "Home Folder" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev qovluğu"
          }
        }
      }
    },
    "How XCleaner keeps you safe" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner sizi necə qoruyur"
          }
        }
      }
    },
    "How hard macOS has to work to find free memory. High pressure for a long time means the Mac needs more memory than it has." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-un boş yaddaş tapmaq üçün nə qədər çalışdığı. Uzun müddət yüksək təzyiq Mac-a olduğundan çox yaddaş lazım olduğunu göstərir."
          }
        }
      }
    },
    "Identical files and folders, compared by their content. One copy of everything always stays." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Məzmununa görə müqayisə edilən eyni fayl və qovluqlar. Hər şeyin bir nüsxəsi həmişə qalır."
          }
        }
      }
    },
    "Identical files and folders, with Smart Select and folder merging." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyni fayl və qovluqlar — ağıllı seçim və qovluqların birləşdirilməsi ilə."
          }
        }
      }
    },
