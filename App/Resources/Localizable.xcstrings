      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder-də göstər"
          }
        }
      }
    },
    "Show, find and manage hidden files." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli faylları göstərin, tapın və idarə edin."
          }
        }
      }
    },
    "Similar Photos" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxşar şəkillər"
          }
        }
      }
    },
    "Space macOS frees on its own when it needs it, such as local snapshots and optimized iCloud copies." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-un lazım olanda özü boşaltdığı yer: lokal snapshot-lar, optimallaşdırılmış iCloud nüsxələri və s."
          }
        }
      }
    },
    "Startup Items" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlanğıc elementləri"
          }
        }
      }
    },
    "System Default (%@)" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem dili (%@)"
          }
        }
      }
    },
    "System Junk" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
