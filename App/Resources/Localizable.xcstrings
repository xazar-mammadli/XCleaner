    "Caches, logs and developer files that apps recreate when they need them." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tətbiqlərin lazım olanda yenidən yaratdığı keşlər, loglar və developer faylları."
