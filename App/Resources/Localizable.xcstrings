          }
        }
      }
    },
    "User caches, logs and developer junk such as Xcode build data." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstifadəçi keşləri, loglar və Xcode build məlumatları kimi developer zibili."
          }
