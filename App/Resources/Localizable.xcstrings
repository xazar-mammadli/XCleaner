        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ boşdur"
          }
        }
      }
    },
    "%@ available of %@" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ boşdur, cəmi %2$@"
