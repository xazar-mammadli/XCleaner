    "Large files you haven't opened in a long time, filtered by type." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoxdan açmadığınız böyük fayllar, növünə görə filtrlənmiş."
