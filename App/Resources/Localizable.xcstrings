    "%@ goes to the Trash, where you can put it back." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zibil qutusuna gedir, oradan geri qaytara bilərsiniz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В корзину отправится %@, оттуда всё можно вернуть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Çöp Sepeti'ne gider, oradan geri alabilirsiniz."
          }
        }
      }
    },
    "%@ is running. Quit it before uninstalling or resetting." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ işləyir. Silməzdən və ya sıfırlamazdan əvvəl onu bağlayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение %@ запущено. Завершите его перед удалением или сбросом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ çalışıyor. Kaldırmadan veya sıfırlamadan önce kapatın."
