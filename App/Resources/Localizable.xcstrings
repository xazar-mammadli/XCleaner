    "Each entry is named after an app that is no longer installed. Look before you remove: some are shared by several apps." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər qeyd artıq quraşdırılmamış bir tətbiqin adını daşıyır. Silməzdən əvvəl baxın: bəziləri bir neçə tətbiq tərəfindən paylaşılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая запись названа по приложению, которое уже не установлено. Проверьте перед удалением: некоторые файлы общие для нескольких приложений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her girdi artık yüklü olmayan bir uygulamanın adını taşır. Silmeden önce bakın: bazılarını birkaç uygulama paylaşır."
          }
        }
      }
    },
    "Each tool shows you exactly what it found before anything is removed." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər alət heç nə silməzdən əvvəl nə tapdığını sizə dəqiq göstərir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый инструмент показывает, что именно он нашёл, прежде чем что-либо удалить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her araç, bir şey silinmeden önce tam olarak ne bulduğunu gösterir."
          }
        }
      }
    },
    "Effects, instruments and audio devices for music and calling apps." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiqi və zəng tətbiqləri üçün effektlər, alətlər və audio cihazlar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эффекты, инструменты и аудиоустройства для музыкальных приложений и звонков."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müzik ve arama uygulamaları için efektler, enstrümanlar ve ses aygıtları."
          }
        }
      }
    },
