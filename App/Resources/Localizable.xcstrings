    "General" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ümumi"
          }
        }
      }
    },
    "Handy extras: a menu bar monitor, hidden files and your cleanup history." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faydalı əlavələr: menyu zolağı monitoru, gizli fayllar və təmizləmə tarixçəsi."
