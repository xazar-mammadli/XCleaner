        }
      }
    },
    "Not Now" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndi yox"
          }
        }
      }
    },
    "Nothing is removed" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heç nə silinmir"
          }
        }
      }
    },
    "Nothing is removed until you review it." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz baxmayınca heç nə silinmir."
          }
        }
      }
    },
    "Old .dmg and .pkg installers, unneeded archives and old screenshots." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köhnə .dmg və .pkg quraşdırıcıları, lazımsız arxivlər və köhnə ekran şəkilləri."
          }
        }
      }
    },
    "Open System Settings" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings-i aç"
