        }
      }
    },
    "Near-identical shots, so you can keep the best one." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demək olar ki, eyni olan şəkillər — ən yaxşısını saxlayın."
