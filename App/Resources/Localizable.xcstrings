{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ available of %@" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ boşdur, cəmi %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ available of %2$@"
          }
        }
      }
    },
    "A record of every removal is kept on this Mac." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər silinmənin qeydi bu Mac-da saxlanılır."
