    "“%@” from the same developer is still installed" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyni developerin “%@” tətbiqi hələ quraşdırılıb"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» того же разработчика ещё установлено"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı geliştiricinin “%@” uygulaması hâlâ yüklü"
          }
        }
      }
    },
    "“%@” is a link, a package such as an app, a hidden folder or a file kept in the cloud. XCleaner only merges plain files and folders." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” keçid, tətbiq kimi paket, gizli qovluq və ya buludda saxlanılan fayldır. XCleaner yalnız adi fayl və qovluqları birləşdirir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — это ссылка, пакет вроде приложения, скрытая папка или файл в облаке. XCleaner объединяет только обычные файлы и папки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bir bağlantı, uygulama gibi bir paket, gizli bir klasör ya da bulutta tutulan bir dosya. XCleaner yalnızca sıradan dosya ve klasörleri birleştirir."
          }
        }
      }
    },
    "“%@” is read-only, so files can't be moved in or out of it." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” yalnız oxunandır, ona görə fayllar ora köçürülə və oradan çıxarıla bilməz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» доступна только для чтения, поэтому файлы нельзя переместить в неё или из неё."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” salt okunur; dosyalar ona taşınamaz ya da ondan çıkarılamaz."
          }
        }
      }
    }
  },
  "version" : "1.0"
