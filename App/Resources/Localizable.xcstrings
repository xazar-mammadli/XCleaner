    "Background Item Check" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fon elementlərinin yoxlanışı"
          }
        }
      }
    },
    "Background tasks that run for the whole Mac, even before anyone logs in. Switching one asks for your password." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün Mac üçün, hələ heç kim daxil olmamışdan işləyən fon tapşırıqları. Birini dəyişmək parolunuzu tələb edir."
          }
        }
      }
    },
    "Background tasks that run while you're logged in. Switching one off keeps it from starting until you switch it on again." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz daxil olduğunuz müddətdə işləyən fon tapşırıqları. Birini söndürsəniz, yenidən yandırana qədər işə düşməyəcək."
          }
        }
      }
    },
    "Battery" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batareya"
          }
        }
      }
    },
    "Biggest & Old Files" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyük və köhnə fayllar"
