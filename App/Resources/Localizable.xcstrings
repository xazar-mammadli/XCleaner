    "%@ will ask again the next time it wants to %@." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ növbəti dəfə %2$@ istəyəndə yenidən soruşacaq."
