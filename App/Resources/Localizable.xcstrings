{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ available of %@" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ boşdur, cəmi %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ available of %2$@"
          }
        }
      }
    },
    "A record of every removal is kept on this Mac." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər silinmənin qeydi bu Mac-da saxlanılır."
          }
        }
      }
    },
    "Allow Full Disk Access" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Girişinə icazə verin"
          }
        }
      }
    },
    "An interactive map of what fills your disk." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskinizi nəyin doldurduğunu göstərən interaktiv xəritə."
          }
        }
      }
    },
    "App Permissions" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqram icazələri"
          }
        }
      }
    },
    "Applications" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramlar"
          }
        }
      }
    },
    "Apps that use the most memory and processor time." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ən çox yaddaş və prosessor vaxtı işlədən proqramlar."
          }
        }
      }
    },
    "Background Item Check" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fon elementlərinin yoxlanışı"
          }
        }
      }
    },
    "Biggest & Old Files" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyük və köhnə fayllar"
          }
        }
      }
    },
    "Browser Data" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauzer məlumatları"
          }
        }
      }
    },
    "Caches and logs in system folders, removed through a secure helper." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem qovluqlarındakı keş və loglar — təhlükəsiz köməkçi vasitəsilə silinir."
          }
        }
      }
    },
    "Check Again" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenidən yoxla"
          }
        }
      }
    },
    "Cleanup" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təmizlik"
          }
        }
      }
    },
    "Cleanup History" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təmizləmə tarixçəsi"
          }
        }
      }
    },
    "Clear browsing traces and check which apps can reach your data." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauzer izlərini təmizləyin və hansı proqramların məlumatlarınıza çıxışı olduğunu yoxlayın."
          }
        }
      }
    },
    "Click Open System Settings." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“System Settings-i aç” düyməsini basın."
          }
        }
      }
    },
    "Coming to this section" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölməyə gələcək"
          }
        }
      }
    },
    "Copies of attachments saved by the Mail app." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail proqramının saxladığı qoşma nüsxələri."
          }
        }
      }
    },
    "Couldn't check Full Disk Access" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Girişini yoxlamaq alınmadı"
          }
        }
      }
    },
    "Delete immediately" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dərhal sil"
          }
        }
      }
    },
    "Disk Map" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk xəritəsi"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazırdır"
          }
        }
      }
    },
    "Duplicates" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dublikatlar"
          }
        }
      }
    },
    "Each tool shows you exactly what it found before anything is removed." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər alət heç nə silməzdən əvvəl nə tapdığını sizə dəqiq göstərir."
          }
        }
      }
    },
    "Every action is recorded in the cleanup history." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər əməliyyat təmizləmə tarixçəsinə yazılır."
          }
        }
      }
    },
    "Everything XCleaner removed, and when." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner-in nəyi, nə vaxt sildiyinin tam siyahısı."
          }
        }
      }
    },
    "Extensions" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genişlənmələr"
          }
        }
      }
    },
    "Files" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fayllar"
          }
        }
      }
    },
    "Files left behind by apps that were already deleted." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artıq silinmiş proqramlardan qalan fayllar."
          }
        }
      }
    },
    "Files you pick yourself, such as large files and duplicates, always go to the Trash." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özünüz seçdiyiniz fayllar (məsələn, böyük fayllar və dublikatlar) həmişə Zibil qutusuna gedir."
          }
        }
      }
    },
    "Find out what takes up space: big files, duplicates and a map of your disk." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeri nəyin tutduğunu öyrənin: böyük fayllar, dublikatlar və diskinizin xəritəsi."
          }
        }
      }
    },
    "Finds caches, logs and other junk that is safe to remove. You review everything before anything is removed." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinməsi təhlükəsiz olan keşləri, logları və digər zibili tapır. Heç nə silinməzdən əvvəl hər şeyi özünüz nəzərdən keçirirsiniz."
          }
        }
      }
    },
    "Flags unsigned or suspicious items that start automatically." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avtomatik işə düşən imzasız və ya şübhəli elementləri göstərir."
          }
        }
      }
    },
    "Free" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş"
          }
        }
      }
    },
    "Full Disk Access is off" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Girişi bağlıdır"
          }
        }
      }
    },
    "Full Disk Access is on" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Girişi aktivdir"
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ümumi"
          }
        }
      }
    },
    "Handy extras: a menu bar monitor, hidden files and your cleanup history." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faydalı əlavələr: menyu zolağı monitoru, gizli fayllar və təmizləmə tarixçəsi."
          }
        }
      }
    },
    "Heavy Apps" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağır proqramlar"
          }
        }
      }
    },
    "Hidden Files" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli fayllar"
          }
        }
      }
    },
    "History, cookies and caches of Safari, Chrome, Firefox, Edge and Brave." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, Chrome, Firefox, Edge və Brave-in tarixçəsi, cookie-ləri və keşi."
          }
        }
      }
    },
    "How XCleaner keeps you safe" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner sizi necə qoruyur"
          }
        }
      }
    },
    "Identical files and folders, with Smart Select and folder merging." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyni fayl və qovluqlar — ağıllı seçim və qovluqların birləşdirilməsi ilə."
          }
        }
      }
    },
    "If macOS asks, choose Quit & Reopen." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS soruşarsa, “Quit & Reopen” seçin."
