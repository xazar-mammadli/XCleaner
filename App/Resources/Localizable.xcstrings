    "Updates from developers, the App Store and Homebrew in one list." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developerlərdən, App Store-dan və Homebrew-dan gələn yeniləmələr bir siyahıda."
          }
        }
      }
    },
    "Used" : {
      "localizations" : {
