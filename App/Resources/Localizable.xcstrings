    "Makes your Mac forget the addresses of websites it looked up. Helps when sites don't open after a network or DNS change." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-ın axtardığı saytların ünvanlarını unutdurur. Şəbəkə və ya DNS dəyişikliyindən sonra saytlar açılmayanda kömək edir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac забудет адреса сайтов, которые уже находил. Помогает, если после смены сети или DNS сайты не открываются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'inizin aradığı web sitelerinin adreslerini unutmasını sağlar. Ağ veya DNS değişikliğinden sonra siteler açılmadığında işe yarar."
          }
        }
      }
    },
