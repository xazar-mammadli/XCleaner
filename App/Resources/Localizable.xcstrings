    "Add a file or folder" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fayl və ya qovluq əlavə et"
          }
        }
      }
    },
    "Add-ons for macOS and for your browsers: preference panes, plug-ins, services and browser extensions." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS və brauzerləriniz üçün əlavələr: ayar panelləri, plug-in-lər, xidmətlər və brauzer əlavələri."
          }
        }
      }
    },
    "Add…" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
