      }
    },
    "Utilities" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alətlər"
          }
        }
      }
    },
    "Video" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video"
          }
        }
      }
    },
    "Which apps can use your camera, microphone, screen and files." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera, mikrofon, ekran və fayllarınıza çıxışı olan proqramlar."
          }
        }
      }
    },
    "Without it, XCleaner can't see some caches, logs and app leftovers." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu icazə olmadan XCleaner bəzi keşləri, logları və proqram qalıqlarını görə bilmir."
          }
        }
      }
    },
    "Would be removed: %@" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinəcəkdi: %@"
          }
        }
      }
    },
    "XCleaner" : {
      "shouldTranslate" : false
    },
    "XCleaner can check every location it cleans." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner təmizlədiyi bütün yerləri yoxlaya bilir."
          }
        }
      }
    },
    "XCleaner can now check every location it cleans." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner artıq təmizlədiyi bütün yerləri yoxlaya bilir."
          }
        }
      }
    },
    "XCleaner looks through your home folder for big files, skipping system files, apps and your photo library. Files you pick go to the Trash." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner ev qovluğunuzda böyük faylları axtarır; sistem fayllarını, proqramları və foto kitabxananızı ötürür. Seçdiyiniz fayllar Zibil qutusuna gedir."
          }
        }
      }
    },
    "XCleaner needs Full Disk Access to look inside protected folders, where caches, logs and app leftovers are kept." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner keşlərin, logların və proqram qalıqlarının saxlandığı qorunan qovluqlara baxmaq üçün Tam Disk Girişinə (Full Disk Access) ehtiyac duyur."
          }
        }
      }
    },
    "XCleaner never scans or removes anything in these locations." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCleaner bu yerlərdə heç nəyi skan etmir və silmir."
          }
        }
      }
    },
    "You can put the files back from the Trash." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faylları Zibil qutusundan geri qaytara bilərsiniz."
          }
        }
      }
    },
    "Your Mac at a glance." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-ınız bir baxışda."
          }
        }
      }
    },
    "Your files never leave this Mac. XCleaner collects no data." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fayllarınız bu Mac-dan heç vaxt çıxmır. XCleaner heç bir məlumat toplamır."
          }
        }
      }
    },
    "Your personal files always go to the Trash first." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şəxsi fayllarınız həmişə əvvəlcə Zibil qutusuna gedir."
          }
        }
      }
    },
    "^[%lld file](inflect: true), %@" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fayl, %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "^[%1$lld file](inflect: true), %2$@"
