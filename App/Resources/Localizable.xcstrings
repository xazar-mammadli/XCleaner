    "Background tasks that run for the whole Mac, even before anyone logs in. Switching one asks for your password." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün Mac üçün, hələ heç kim daxil olmamışdan işləyən fon tapşırıqları. Birini dəyişmək parolunuzu tələb edir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновые задачи для всего Mac, которые работают ещё до входа в систему. Для переключения потребуется пароль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimse giriş yapmadan önce bile tüm Mac için çalışan arka plan görevleri. Birini değiştirmek parolanızı ister."
          }
        }
      }
    },
    "Background tasks that run while you're logged in. Switching one off keeps it from starting until you switch it on again." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz daxil olduğunuz müddətdə işləyən fon tapşırıqları. Birini söndürsəniz, yenidən yandırana qədər işə düşməyəcək."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновые задачи, которые работают, пока вы в системе. Выключенная задача не запустится, пока вы её снова не включите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açıkken çalışan arka plan görevleri. Kapattığınız bir görev, yeniden açana kadar başlamaz."
          }
        }
      }
    },
