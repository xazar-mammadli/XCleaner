          }
        }
      }
    },
    "Found %@ from ^[%lld app](inflect: true)" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld tətbiqdən %1$@ tapıldı"
