    "Always running" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Həmişə işləyir"
          }
        }
      }
    },
    "An app or tool that uses it may lose its settings or data. You can put it back from the Trash." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu istifadə edən proqram və ya alət ayarlarını, yaxud məlumatlarını itirə bilər. Onu Zibil qutusundan geri qaytara bilərsiniz."
          }
        }
      }
    },
    "An interactive map of what fills your disk." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskinizi nəyin doldurduğunu göstərən interaktiv xəritə."
          }
        }
      }
    },
    "Android emulators and settings" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android emulyatorları və ayarları"
