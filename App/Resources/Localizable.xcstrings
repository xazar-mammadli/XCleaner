            "state" : "translated",
            "value" : "Свободно"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş"
          }
        }
      }
    },
    "Frees %@ once the Trash is emptied" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zibil qutusu boşaldılanda %@ yer boşalır"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободит %@ после очистки корзины"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepeti boşaltılınca %@ boşalır"
          }
        }
      }
    },
    "Frees the space taken by local Time Machine snapshots, which macOS keeps between backups. Backups on your backup disk stay as they are." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-un yedəkləmələr arasında saxladığı lokal Time Machine snapshot-larının tutduğu yeri boşaldır. Yedəkləmə diskindəki yedəklər olduğu kimi qalır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освобождает место, занятое локальными снимками Time Machine, которые macOS хранит между резервными копиями. Копии на диске резервного копирования остаются без изменений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS'in yedeklemeler arasında tuttuğu yerel Time Machine anlık görüntülerinin kapladığı alanı boşaltır. Yedekleme diskinizdeki yedekler olduğu gibi kalır."
          }
        }
      }
    },
