        }
      }
    },
    "Installers, unpacked archives, old screenshots and forgotten downloads. These go to the Trash." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quraşdırıcılar, artıq açılmış arxivlər, köhnə ekran şəkilləri və unudulmuş yükləmələr. Bunlar Zibil qutusuna gedir."
          }
        }
      }
    },
    "Items already in the Trash. Removing them deletes them for good." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artıq Zibil qutusunda olan elementlər. Onları silmək həmişəlik silmək deməkdir."
