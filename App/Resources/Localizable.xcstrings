    "An app or tool that uses it may lose its settings or data. You can put it back from the Trash." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu istifadə edən tətbiq və ya alət ayarlarını, yaxud məlumatlarını itirə bilər. Onu Zibil qutusundan geri qaytara bilərsiniz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение или инструмент, который его использует, может потерять настройки или данные. Его можно вернуть из корзины."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu kullanan bir uygulama veya araç ayarlarını ya da verilerini kaybedebilir. Çöp Sepeti'nden geri alabilirsiniz."
          }
        }
      }
    },
